# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_generatewith_openssl_rand_hex_32

# ─── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite:///./datapilot.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/datapilot

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ─── Sessions & Cookies ────────────────────────────────────────────────────────
SESSION_DAYS=7
COOKIE_SECURE=false            # Set to true in production (HTTPS only)
COOKIE_SAMESITE=lax

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=20

# ─── OTP / Email Verification ──────────────────────────────────────────────────
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ─── Email Provider ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend          # Options: resend | smtp
EMAIL_FROM=DataPilot AI <verify@yourdomain.com>

# Resend (https://resend.com)
RESEND_API_KEY=

# SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ─── AI Providers ──────────────────────────────────────────────────────────────
# WARNING: Keep API keys on backend only. Never put them in frontend/.env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated admin email addresses for initial admin setup
ADMIN_EMAILS=admin@yourdomain.com
